[Unit]
Description=mondo-a-rotoli consulta watcher
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi/mondo-a-rotoli
EnvironmentFile=/home/pi/mondo-a-rotoli/consulta/.env
ExecStart=/home/pi/mondo-a-rotoli/consulta/venv/bin/python3 /home/pi/mondo-a-rotoli/consulta/watcher.py
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=multi-user.target
